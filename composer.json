{
    "name": "wfp-org/backend",
    "description": "WFP Backend in Pure PHP 8",
    "type": "project",
    "require": {
        "php": ">=8.0",
        "ext-pdo": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "App\\Controllers\\": "app/controllers/",
            "App\\Models\\": "app/models/",
            "App\\Core\\": "app/core/",
            "App\\Middleware\\": "app/middleware/"
        }
    },
    "authors": [
        {
            "name": "WFP Development Team",
            "email": "dev@wfp.org"
        }
    ],
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}